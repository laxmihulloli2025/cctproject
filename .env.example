# =========================================================
# SmartPark Cloud — Environment Configuration
# =========================================================
# NOTE: If you do not provide these credentials, SmartPark Cloud
# automatically launches in "Zero-Config Demo Mode" with pre-seeded
# 60-slot live IoT simulation and local persistence.
#
# To connect your own Supabase project:
# 1. Create a project at https://supabase.com
# 2. Run the SQL script from `supabase/schema.sql` in Supabase SQL Editor
# 3. Copy your project URL & Anon Key below and rename this file to `.env`
# =========================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
